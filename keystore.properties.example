# File mẫu cấu hình ký bản phát hành (Release Keystore)
# Copy file này thành keystore.properties ở thư mục gốc và điền thông tin thực tế.
# CHÚ Ý: KHÔNG commit keystore.properties hoặc file .jks/.keystore vào Git.

storeFile=release.jks
storePassword=your_store_password
keyAlias=your_key_alias
keyPassword=your_key_password
